# PostgreSQL hébergé dans l'UE, avec ?sslmode=require au minimum
NUXT_DATABASE_URL=

# 32 caractères minimum. La changer déconnecte tout le monde
# et invalide les liens d'inscription en attente.
NUXT_SESSION_PASSWORD=

# URL publique (ex. https://ticawa.fr). Obligatoire en prod, vide en dev.
NUXT_SITE_URL=

# Mails (Brevo)
NUXT_BREVO_API_KEY=
NUXT_MAIL_FROM_EMAIL=
NUXT_MAIL_FROM_NAME=Ticawa

# « Continuer avec Google » (facultatif)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Origines supplémentaires autorisées à écrire sur l'API (ex. capacitor://localhost)
NUXT_TRUSTED_ORIGINS=
